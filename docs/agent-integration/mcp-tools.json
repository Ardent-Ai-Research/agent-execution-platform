{
  "version": "0.1.0",
  "service": "ardent-agent-execution",
  "baseUrlEnv": "ARDENT_BASE_URL",
  "defaultBaseUrl": "https://api.ardentresearch.xyz",
  "auth": {
    "header": "X-API-Key",
    "tokenEnv": "ARDENT_API_KEY"
  },
  "tools": [
    {
      "name": "ardent_health",
      "description": "Check API health status",
      "method": "GET",
      "path": "/health",
      "authRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_feed_recent",
      "description": "Read public recent activity feed",
      "method": "GET",
      "path": "/feed/recent",
      "authRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 12
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_get_wallet",
      "description": "Resolve/provision an ERC-4337 wallet for an agent_id",
      "method": "GET",
      "path": "/wallet",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": {
            "type": "string",
            "enum": ["ethereum", "base", "arbitrum"],
            "default": "ethereum"
          }
        },
        "required": ["agent_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_wallet_balance",
      "description": "Get native token (ETH) and ERC-20 balances for an agent's smart wallet. Call this before execute to verify the wallet is funded.",
      "method": "GET",
      "path": "/wallet/balance",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": {
            "type": "string",
            "enum": ["ethereum", "base", "arbitrum"],
            "default": "ethereum"
          }
        },
        "required": ["agent_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_simulate",
      "description": "Simulate execution request before broadcast",
      "method": "POST",
      "path": "/simulate",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": {
            "type": "string",
            "enum": ["ethereum", "base", "arbitrum"]
          },
          "target_contract": { "type": "string" },
          "calldata": { "type": "string" },
          "value": { "type": "string", "default": "0" },
          "strategy_id": { "type": ["string", "null"] },
          "batch_calls": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "target_contract": { "type": "string" },
                "calldata": { "type": "string" },
                "value": { "type": "string", "default": "0" }
              },
              "required": ["target_contract", "calldata"],
              "additionalProperties": false
            }
          },
          "callback_url": { "type": ["string", "null"], "format": "uri" }
        },
        "required": ["agent_id", "chain"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_execute",
      "description": "Execute request. In manual mode may return payment_required (402)",
      "method": "POST",
      "path": "/execute",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": {
            "type": "string",
            "enum": ["ethereum", "base", "arbitrum"]
          },
          "target_contract": { "type": "string" },
          "calldata": { "type": "string" },
          "value": { "type": "string", "default": "0" },
          "strategy_id": { "type": ["string", "null"] },
          "batch_calls": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "target_contract": { "type": "string" },
                "calldata": { "type": "string" },
                "value": { "type": "string", "default": "0" }
              },
              "required": ["target_contract", "calldata"],
              "additionalProperties": false
            }
          },
          "callback_url": { "type": ["string", "null"], "format": "uri" },
          "payment_proof": {
            "type": ["object", "null"],
            "description": "Optional value to encode as JSON in X-Payment-Proof header",
            "properties": {
              "request_id": { "type": "string" },
              "payer": { "type": "string" },
              "token": { "type": "string" },
              "chain": { "type": "string" },
              "tx_hash": { "type": "string" }
            },
            "required": ["request_id", "payer", "token", "chain", "tx_hash"],
            "additionalProperties": false
          }
        },
        "required": ["agent_id", "chain"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_supply_simulate",
      "description": "Simulate supplying an asset into Aave V3 on Sepolia. The server compiles approve -> Pool.supply as an ERC-4337 batch.",
      "method": "POST",
      "path": "/protocols/aave-v3/supply/simulate",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": {
            "type": "string",
            "enum": ["ethereum"],
            "default": "ethereum"
          },
          "asset": {
            "type": "string",
            "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"]
          },
          "amount": {
            "type": ["string", "null"],
            "description": "Human-readable token amount, e.g. 1.25"
          },
          "amount_raw": {
            "type": ["string", "null"],
            "description": "Raw token base-unit amount. Provide either amount or amount_raw."
          },
          "referral_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_supply_execute",
      "description": "Execute supplying an asset into Aave V3 on Sepolia. In manual mode may return payment_required (402).",
      "method": "POST",
      "path": "/protocols/aave-v3/supply",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": {
            "type": "string",
            "enum": ["ethereum"],
            "default": "ethereum"
          },
          "asset": {
            "type": "string",
            "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"]
          },
          "amount": {
            "type": ["string", "null"],
            "description": "Human-readable token amount, e.g. 1.25"
          },
          "amount_raw": {
            "type": ["string", "null"],
            "description": "Raw token base-unit amount. Provide either amount or amount_raw."
          },
          "referral_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" },
          "payment_proof": {
            "type": ["object", "null"],
            "description": "Optional value to encode as JSON in X-Payment-Proof header",
            "properties": {
              "request_id": { "type": "string" },
              "payer": { "type": "string" },
              "token": { "type": "string" },
              "chain": { "type": "string" },
              "tx_hash": { "type": "string" }
            },
            "required": ["request_id", "payer", "token", "chain", "tx_hash"],
            "additionalProperties": false
          }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_withdraw_simulate",
      "description": "Simulate withdrawing an asset from Aave V3 on Sepolia. Amount may be a number string or max.",
      "method": "POST",
      "path": "/protocols/aave-v3/withdraw/simulate",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" },
          "asset": { "type": "string", "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"] },
          "amount": { "type": ["string", "null"], "description": "Human-readable amount, or max" },
          "amount_raw": { "type": ["string", "null"], "description": "Raw base-unit amount, or max" },
          "to": { "type": ["string", "null"], "description": "Optional recipient address; defaults to agent wallet" },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_withdraw_execute",
      "description": "Execute withdrawing an asset from Aave V3 on Sepolia. In manual mode may return payment_required (402).",
      "method": "POST",
      "path": "/protocols/aave-v3/withdraw",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" },
          "asset": { "type": "string", "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"] },
          "amount": { "type": ["string", "null"], "description": "Human-readable amount, or max" },
          "amount_raw": { "type": ["string", "null"], "description": "Raw base-unit amount, or max" },
          "to": { "type": ["string", "null"], "description": "Optional recipient address; defaults to agent wallet" },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" },
          "payment_proof": {
            "type": ["object", "null"],
            "description": "Optional value to encode as JSON in X-Payment-Proof header",
            "properties": {
              "request_id": { "type": "string" },
              "payer": { "type": "string" },
              "token": { "type": "string" },
              "chain": { "type": "string" },
              "tx_hash": { "type": "string" }
            },
            "required": ["request_id", "payer", "token", "chain", "tx_hash"],
            "additionalProperties": false
          }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_repay_simulate",
      "description": "Simulate repaying Aave V3 debt on Sepolia. The server compiles approve -> Pool.repay as an ERC-4337 batch.",
      "method": "POST",
      "path": "/protocols/aave-v3/repay/simulate",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" },
          "asset": { "type": "string", "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"] },
          "amount": { "type": ["string", "null"], "description": "Human-readable amount, or max" },
          "amount_raw": { "type": ["string", "null"], "description": "Raw base-unit amount, or max" },
          "interest_rate_mode": { "type": ["integer", "null"], "enum": [1, 2], "default": 2 },
          "on_behalf_of": { "type": ["string", "null"], "description": "Optional debt owner; defaults to agent wallet" },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_repay_execute",
      "description": "Execute repaying Aave V3 debt on Sepolia. In manual mode may return payment_required (402).",
      "method": "POST",
      "path": "/protocols/aave-v3/repay",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" },
          "asset": { "type": "string", "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"] },
          "amount": { "type": ["string", "null"], "description": "Human-readable amount, or max" },
          "amount_raw": { "type": ["string", "null"], "description": "Raw base-unit amount, or max" },
          "interest_rate_mode": { "type": ["integer", "null"], "enum": [1, 2], "default": 2 },
          "on_behalf_of": { "type": ["string", "null"], "description": "Optional debt owner; defaults to agent wallet" },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" },
          "payment_proof": {
            "type": ["object", "null"],
            "description": "Optional value to encode as JSON in X-Payment-Proof header",
            "properties": {
              "request_id": { "type": "string" },
              "payer": { "type": "string" },
              "token": { "type": "string" },
              "chain": { "type": "string" },
              "tx_hash": { "type": "string" }
            },
            "required": ["request_id", "payer", "token", "chain", "tx_hash"],
            "additionalProperties": false
          }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_borrow_simulate",
      "description": "Simulate borrowing from Aave V3 on Sepolia. The server checks projected health factor before simulating the Pool.borrow call.",
      "method": "POST",
      "path": "/protocols/aave-v3/borrow/simulate",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" },
          "asset": { "type": "string", "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"] },
          "amount": { "type": ["string", "null"], "description": "Human-readable amount, or max" },
          "amount_raw": { "type": ["string", "null"], "description": "Raw base-unit amount, or max" },
          "interest_rate_mode": { "type": ["integer", "null"], "enum": [1, 2], "default": 2 },
          "referral_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
          "on_behalf_of": { "type": ["string", "null"], "description": "Optional debt owner; defaults to agent wallet" },
          "min_health_factor": { "type": ["string", "null"], "description": "Minimum projected health factor after borrow; default 1.05; must be at least 1.0" },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_borrow_execute",
      "description": "Execute borrowing from Aave V3 on Sepolia after projected health-factor guard. In manual mode may return payment_required (402).",
      "method": "POST",
      "path": "/protocols/aave-v3/borrow",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" },
          "asset": { "type": "string", "enum": ["AAVE", "DAI", "EURS", "GHO", "LINK", "USDC", "USDT", "WBTC", "WETH"] },
          "amount": { "type": ["string", "null"], "description": "Human-readable amount, or max" },
          "amount_raw": { "type": ["string", "null"], "description": "Raw base-unit amount, or max" },
          "interest_rate_mode": { "type": ["integer", "null"], "enum": [1, 2], "default": 2 },
          "referral_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
          "on_behalf_of": { "type": ["string", "null"], "description": "Optional debt owner; defaults to agent wallet" },
          "min_health_factor": { "type": ["string", "null"], "description": "Minimum projected health factor after borrow; default 1.05; must be at least 1.0" },
          "strategy_id": { "type": ["string", "null"] },
          "callback_url": { "type": ["string", "null"], "format": "uri" },
          "payment_proof": {
            "type": ["object", "null"],
            "description": "Optional value to encode as JSON in X-Payment-Proof header",
            "properties": {
              "request_id": { "type": "string" },
              "payer": { "type": "string" },
              "token": { "type": "string" },
              "chain": { "type": "string" },
              "tx_hash": { "type": "string" }
            },
            "required": ["request_id", "payer", "token", "chain", "tx_hash"],
            "additionalProperties": false
          }
        },
        "required": ["agent_id", "asset"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_aave_position",
      "description": "Read Aave V3 Sepolia account data for an agent wallet, including collateral, debt, available borrows, LTV, liquidation threshold, and health factor.",
      "method": "GET",
      "path": "/protocols/aave-v3/position",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "chain": { "type": "string", "enum": ["ethereum"], "default": "ethereum" }
        },
        "required": ["agent_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "ardent_status",
      "description": "Get execution request status by request_id",
      "method": "GET",
      "path": "/status/{id}",
      "authRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "request_id UUID"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  ]
}
