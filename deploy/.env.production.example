# Copy to deploy/.env.production on the server. Do not commit the real file.
# Generate database and Redis values with: openssl rand -hex 32

API_DOMAIN=api.ardentresearch.xyz
ACME_EMAIL=ops@example.com

POSTGRES_USER=agent_exec
POSTGRES_DB=agent_exec
POSTGRES_PASSWORD=<64-hex-character-secret>
REDIS_PASSWORD=<64-hex-character-secret>

HOST=0.0.0.0
PORT=8080
NUM_WORKERS=2
MAX_CONCURRENT_REQUESTS=200
RUST_LOG=info

# Copy this exact value from Railway. Changing it prevents the platform from
# decrypting existing agent signing keys and its DB-backed paymaster signer.
WALLET_ENCRYPTION_KEY=<existing-64-hex-character-key>

# Shared deterministic ERC-4337 contracts. Copy the existing hosted values.
EVM_ENTRY_POINT_ADDRESS=0x433709009B8330FDa32311DF1C2AFA402eD8D009
EVM_FACTORY_ADDRESS=0xYourSimpleAccountFactory
EVM_PAYMASTER_ADDRESS=0xYourVerifyingPaymaster

# Configure every chain currently enabled on the hosted Testnet V2 backend.
ETHEREUM_RPC_URL=https://your-ethereum-sepolia-rpc
ETHEREUM_BUNDLER_RPC_URL=https://your-ethereum-sepolia-bundler
BASE_RPC_URL=https://your-base-sepolia-rpc
BASE_BUNDLER_RPC_URL=https://your-base-sepolia-bundler
ARBITRUM_RPC_URL=https://your-arbitrum-sepolia-rpc
ARBITRUM_BUNDLER_RPC_URL=https://your-arbitrum-sepolia-bundler

ETHEREUM_TRACKED_TOKENS=USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ETHEREUM_TRACKED_TOKEN_DECIMALS=USDC=6
BASE_TRACKED_TOKENS=USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_TRACKED_TOKEN_DECIMALS=USDC=6
ARBITRUM_TRACKED_TOKENS=USDC=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
ARBITRUM_TRACKED_TOKEN_DECIMALS=USDC=6

PER_KEY_RATE_LIMIT_RPS=5
PER_KEY_RATE_LIMIT_BURST=10
PUBLIC_API_KEY_LIMIT=5
PUBLIC_API_KEY_WINDOW_SECS=3600

# The bundled Caddy edge proxy removes client-supplied values and writes this
# header itself. Do not set this when using an untrusted proxy instead.
PUBLIC_API_KEY_CLIENT_IP_HEADER=x-execute-client-ip

CORS_ORIGIN=https://ardentresearch.xyz,https://www.ardentresearch.xyz
